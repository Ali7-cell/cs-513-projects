datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PresentationStatus {
  PENDING
  COMPLETED
}

enum MemberRole {
  LEADER
  MEMBER
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  sectionCode  String?
  regNumber    String?
  groups       Group[]    @relation("UserGroups")
  auditLogs    AuditLog[] @relation("UserAudits")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("users")
}

model Section {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  semester  String   @default("5th Semester")
  program   String   @default("BS Information Technology")
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

model Group {
  id              String                @id @default(cuid())
  groupName       String
  sectionId       String
  section         Section               @relation(fields: [sectionId], references: [id])
  createdById     String
  createdBy       User                  @relation("UserGroups", fields: [createdById], references: [id])
  reviewStatus    ReviewStatus          @default(PENDING_REVIEW)
  rejectionReason String?
  members         GroupMember[]
  project         Project?
  presentation    Presentation?
  schedule        PresentationSchedule?
  attachments     ProjectAttachment[]
  reviewHistory   GroupReviewHistory[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([sectionId, groupName])
  @@map("groups")
}

model GroupMember {
  id           String     @id @default(cuid())
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fullName     String
  regNumber    String
  role         MemberRole @default(MEMBER)
  displayOrder Int
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@index([regNumber, isActive])
  @@map("group_members")
}

model Project {
  id            String   @id @default(cuid())
  groupId       String   @unique
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ideaName      String
  description   String
  projectPdfUrl String?
  githubUrl     String?
  websiteUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("projects")
}

model Presentation {
  id            String             @id @default(cuid())
  groupId       String             @unique
  group         Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        PresentationStatus @default(PENDING)
  markedBy      String?
  markedAt      DateTime?
  scheduledDate DateTime?
  venue         String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@map("presentations")
}

model PresentationSchedule {
  id          String   @id @default(cuid())
  groupId     String   @unique
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  venue       String?  @default("CS Lab 1 / IT Department")
  notes       String?
  scheduledBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("presentation_schedules")
}

model SubmissionDeadline {
  id        String   @id @default(cuid())
  title     String   @default("BS IT 5th Semester Group Registration")
  deadline  DateTime
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("submission_deadlines")
}

model ProjectAttachment {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  fileSize   Int
  fileUrl    String
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@map("project_attachments")
}

model GroupReviewHistory {
  id        String       @id @default(cuid())
  groupId   String
  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status    ReviewStatus
  reason    String?
  actorId   String
  createdAt DateTime     @default(now())

  @@map("group_review_history")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actor         User     @relation("UserAudits", fields: [actorUserId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousValue String?
  newValue      String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
