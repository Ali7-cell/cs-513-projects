# Database Connection (Neon PostgreSQL)
# Use pooled connection URL for Next.js runtime (Pgbouncer enabled)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct connection URL for Prisma CLI migrations
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-string-using-openssl-rand-hex-32"

# Administrator Bootstrap Seed Credentials
ADMIN_BOOTSTRAP_NAME="Department Administrator"
ADMIN_BOOTSTRAP_EMAIL="admin.it@uaf.edu.pk"
ADMIN_BOOTSTRAP_PASSWORD="UafAdminSecure2026!"
